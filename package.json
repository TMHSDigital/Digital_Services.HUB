{
  "name": "digital-services-hub",
  "version": "1.0.0",
  "description": "A collection of digital tools and utilities",
  "type": "module",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint js/",
    "lint:fix": "eslint js/ --fix",
    "start": "serve ."
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^6.5.1"
  },
  "devDependencies": {
    "@babel/core": "^7.23.6",
    "@babel/preset-env": "^7.23.6",
    "babel-jest": "^29.7.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "serve": "^14.2.1"
  },
  "jest": {
    "transform": {
      "^.+\\.js$": "babel-jest"
    },
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/js/$1"
    }
  }
